@echo off
chcp 65001 >nul
cd /d %~dp0

rem 全量采集：发现电影 -> 逐部抓资料（含评分分布、热门短评）-> 导出。
rem 预计 7~9 小时（豆瓣有人机验证墙，约每分钟只能抓 3 个页面；撞墙了程序会自己等一会儿再继续）。
rem 中途可以随时按 Ctrl+C 停下，重新双击本文件就会从断点继续（不会重复抓）。
set "PY=python"
if exist "%~dp0.venv\Scripts\python.exe" set "PY=%~dp0.venv\Scripts\python.exe"

echo 使用的解释器：%PY%
echo 本窗口可以放着不管；想停就按 Ctrl+C，数据不会丢。
echo.
pause

echo ================================================================
echo  1/3 发现电影（把 id 攒到 1000 部左右）
echo ================================================================
"%PY%" crawl.py discover
echo.
echo ================================================================
echo  2/3 逐部抓电影资料（一页里同时有 资料 + 评分分布 + 热门短评）
echo       —— 最慢的一步，被限流时程序会自动等待后继续
echo ================================================================
"%PY%" crawl.py movie
echo.
echo ================================================================
echo  3/3 导出 CSV / Excel
echo ================================================================
"%PY%" crawl.py export
echo.
"%PY%" crawl.py stats
echo.
echo 全部完成。数据在 export\ 目录里。
pause
