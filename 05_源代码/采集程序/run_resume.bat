@echo off
chcp 65001 >nul
cd /d %~dp0

rem ============================================================
rem  暂停之后接着爬（断点续爬，不会重复抓已经抓好
rem  的电影，失败/没抓完的会被自动跳过重试）
rem  已经抓了 894 部，还剩约 350 部，大约 3 小时。
rem ============================================================

set "PY=python"
if exist "%~dp0.venv\Scripts\python.exe" set "PY=%~dp0.venv\Scripts\python.exe"

echo 使用的解释器：%PY%
echo.

echo ================================================================
echo  1/3 继续抓电影资料 + 评分分布 + 热门短评（断点续爬）
echo ================================================================
"%PY%" crawl.py movie
echo.

echo ================================================================
echo  2/3 导出 CSV / Excel 到 export\ 目录
echo ================================================================
"%PY%" crawl.py export
echo.

echo ================================================================
echo  3/3 当前数据统计
echo ================================================================
"%PY%" crawl.py stats
echo.
echo 完成。暂停/关掉这个窗口都不会丢数据，随时可以再双击本文件续爬。
pause
